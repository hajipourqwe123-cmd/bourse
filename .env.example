# Copy to .env (never commit .env). Secrets are read only from the environment.
SOURCE=replay
REPLAY_FILE=testdata/synthetic_day.ndjson
REPLAY_DELAY=0s
POLL_INTERVAL=5s
SOURCEARENA_URL=https://apis.sourcearena.ir/api/
SOURCEARENA_TOKEN=
# Plan quota (requests per Tehran day): the collector refuses a POLL_INTERVAL that exceeds it.
# SOURCEARENA_BUDGET_FILE=.local/sourcearena-budget.json
# LOCAL comparison only: the collector saves the latest raw payload here (never commit it).
# SOURCEARENA_SAVE_LATEST=.local/sourcearena-latest.json
# BrsApi (SOURCE=brsapi; docs/source-mapping.md). Key from the vendor panel, env only.
BRSAPI_URL=https://api.brsapi.ir/Tsetmc/AllSymbols.php
BRSAPI_KEY=
BRSAPI_TYPES=1
# Plan quota (free plan, as the vendor reported on 2026-09-25). The collector refuses a POLL_INTERVAL
# that exceeds it; raise these only after upgrading the plan.
BRSAPI_DAILY_LIMIT=100
BRSAPI_5MIN_LIMIT=300
# SourceArena plan quota per day (unknown until confirmed in the vendor panel; used by
# infra/preopen-record.sh and the collector). 2026-09-27: the vendor refused after ~45 requests.
SOURCEARENA_DAILY_LIMIT=100
HOT_THRESHOLD_RIAL=2000000000
PLUS_THRESHOLD_RIAL=1000000000
STALE_AFTER=30s
BUS=ndjson
NATS_URL=nats://127.0.0.1:4222
# ENGINE_LEASE_TTL=15s   # single-engine lease (P-02), >= 3s
# SESSIONS_FILE=path.json      # trading-session calendar (default: embedded internal/calendar/sessions.json)
CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=
CENTRIFUGO_SECRET=
CENTRIFUGO_API_KEY=
# Optional: lower if dockerd's fd hard limit is below 262144 (see infra/docker-compose.yml).
# CLICKHOUSE_NOFILE=262144
# JetStream stream caps (all services must agree). production = 37 GiB (default, unchanged);
# local = 20 GiB total, MaxAge 48h, for a developer PC. Optional: STREAM_MAX_AGE, STREAM_<MD|FLOW|AI|QUALITY>_MAX_GIB.
# STREAM_PROFILE=local
